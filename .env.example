# ==============================================================================
# APP MODE — the single switch between real-data and demo operation.
# REAL: every provider must use real external data or the call fails with
#       PROVIDER_NOT_CONFIGURED / PROVIDER_UNAVAILABLE. No synthetic fallback,
#       ever, on this path.
# DEMO: synthetic providers are permitted but every value they return carries
#       kind=SYNTHETIC_DEMO in its provenance, and the frontend renders a
#       persistent "SYNTHETIC DATA — NOT REAL INCIDENT" banner.
# ==============================================================================
APP_MODE=demo
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Sentinel-1 — Copernicus Data Space Ecosystem
# Register (free): https://dataspace.copernicus.eu
# Create an OAuth2 client: Account -> Settings -> OAuth clients
# ------------------------------------------------------------------------------
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# Defaults below match documented CDSE endpoints as of this writing; override
# only if Copernicus changes them.
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_STAC_URL=https://catalogue.dataspace.copernicus.eu/stac
CDSE_DOWNLOAD_URL=https://zipper.dataspace.copernicus.eu/odata/v1

# ------------------------------------------------------------------------------
# ERA5 winds — Copernicus Climate Data Store
# Register: https://cds.climate.copernicus.eu -> profile page -> API key
# ------------------------------------------------------------------------------
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=

# ------------------------------------------------------------------------------
# CMEMS ocean currents — Copernicus Marine Service
# Register: https://data.marine.copernicus.eu
# ------------------------------------------------------------------------------
CMEMS_USERNAME=
CMEMS_PASSWORD=
# Global analysis-and-forecast merged surface current product. Documented
# rationale for this default lives in backend/app/providers/cmems/README.md;
# override if your incident falls in a region better served by a regional
# product (e.g. IBI, Arabian Sea nested product).
CMEMS_DATASET_ID=cmems_mod_glo_phy_anfc_merged-uv_PT1H-i

# ------------------------------------------------------------------------------
# AIS — Global Fishing Watch
# Register: https://globalfishingwatch.org/our-apis/
# ------------------------------------------------------------------------------
AIS_PROVIDER=global_fishing_watch
GFW_API_TOKEN=
GFW_API_URL=https://gateway.api.globalfishingwatch.org

# ------------------------------------------------------------------------------
# Infrastructure
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://varuna:varuna@postgres:5432/varuna_netra
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=varuna_minio
S3_SECRET_KEY=varuna_minio_secret
S3_BUCKET=varuna-netra

# ------------------------------------------------------------------------------
# Pipeline parameters (spec sections 10, 12, 13 — all configurable, none hardcoded)
# ------------------------------------------------------------------------------
WEIGHT_SPATIAL=0.25
WEIGHT_TEMPORAL=0.25
WEIGHT_TRAJECTORY=0.30
WEIGHT_BEHAVIOURAL=0.20

DRIFT_ENSEMBLE_SIZE=1000
DRIFT_BACKWARD_HOURS=72

FALSIFY_MIN_SPATIAL_IOU=0.15
FALSIFY_MAX_CENTROID_KM=25.0
FALSIFY_MAX_ARRIVAL_ERROR_H=6.0
DECISION_LEADING_MARGIN=0.15
DECISION_LEADING_MIN_SCORE=0.60

MODEL_VERSION=varuna-netra-0.1.0
